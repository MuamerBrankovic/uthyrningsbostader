generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bostad {
  id                   String   @id @default(uuid())
  namn                 String
  adress               String?
  stadsdel             String?
  beskrivning          String?
  bilder               String[]
  delade_utrymmen      String[]
  inkluderat           String[]
  narmaste_hallplats   String?
  // Reserv för bostäder utan rum. Typen sätts numera per rum (Rum.bostadstyp)
  // och /bostader filtrerar via rummen — se lib/bostadstyp.ts.
  bostadstyp           String   @default("privat_rum")
  kontaktperson_namn   String?
  kontaktperson_bild   String?
  kontaktperson_email  String?
  kontaktperson_telefon String?
  rum                  Rum[]
  created_at           DateTime @default(now())
}

model Hyresvardsanmalan {
  id          String   @id @default(uuid())
  namn        String
  telefon     String?
  email       String
  stad        String?
  adress      String?
  meddelande  String?
  // Lead-uppföljning (admin) — obehandlad | kontaktad | pagaende | avtal_klart | ej_aktuell
  status          String    @default("obehandlad")
  intern_notering String?   @db.Text
  uppdaterad      DateTime?
  created_at  DateTime @default(now())

  // Admin-lista hämtas sorterad på created_at desc
  @@index([created_at])
}

model Rum {
  id          String     @id @default(uuid())
  bostad_id   String
  bostad      Bostad     @relation(fields: [bostad_id], references: [id], onDelete: Cascade)
  namn        String
  beskrivning String?
  bilder      String[]
  kvm         Int?
  manadshyra  Int
  moblering   String[]
  // Samma värden som Bostad.bostadstyp (lib/bostadstyp.ts). Ligger per rum
  // eftersom ett hus kan ha både rum som delar badrum och rum med eget bad.
  // Prisma kan inte läsa TypeScript — ändras defaulten i lib/bostadstyp.ts
  // måste den ändras här med en migration samtidigt.
  bostadstyp  String     @default("privat_rum")
  // Del av huset, fritext ("Övre våningen"). Bostadssidan grupperar rummen
  // per sektion, i den ordning sektionerna först dyker upp.
  sektion     String?
  bokningar   Bokning[]
  // Rummen visas i skapandeordning (orderBy created_at) — det är den enda
  // sorteringen som finns, så ordningen bestäms när rummen läggs upp.
  created_at  DateTime   @default(now())

  // Rum laddas alltid per bostad (bostadslista + bostadssida include rum).
  // FK-kolumner indexeras inte automatiskt i Postgres.
  @@index([bostad_id])
}

model Bokning {
  id                 String   @id @default(uuid())
  rum_id             String
  rum                Rum      @relation(fields: [rum_id], references: [id], onDelete: Cascade)
  // Sätts när en inloggad användare bokar — "Mina bokningar" filtrerar på
  // denna (aldrig på e-post, som går att kapa via overifierad registrering)
  anvandare_id       String?
  anvandare          Anvandare? @relation(fields: [anvandare_id], references: [id], onDelete: SetNull)
  kund_foretag       String?
  kund_orgnr         String?
  kund_kontaktperson String
  boende_namn        String?
  email              String
  telefon            String?
  startdatum         DateTime
  slutdatum          DateTime?
  // Giltiga värden definieras i lib/bokningsstatus.ts (BOKNING_STATUS).
  // Prisma kan inte läsa TypeScript — ändras de måste defaulten här ändras
  // med en migration samtidigt.
  status             String   @default("forfragan")
  avtalstyp          String   @default("standard")
  // Kontrakthantering (admin) — saknas | uppladdat | skickat | signerat
  kontrakt_url         String?
  kontrakt_status      String    @default("saknas")
  kontrakt_uppdaterad  DateTime?
  // Fakturering (admin, platshållare) — ej_fakturerad | fakturerad | betald
  faktura_status       String    @default("ej_fakturerad")
  created_at         DateTime @default(now())

  @@index([anvandare_id])
  // Tillgänglighets- och överlappskontroller filtrerar bokningar per rum på
  // bekräftad status (bostadslista/-sida, boknings-POST, PATCH-bekräftelse).
  @@index([rum_id, status])
  // Admin "Alla bokningar" sorterar på created_at desc; störst tabellen över tid.
  @@index([created_at])
}

model Anvandare {
  id           String   @id @default(uuid())
  email        String   @unique
  losenord     String
  namn         String
  roll         String   @default("hyresgast")
  bokningar    Bokning[]
  created_at   DateTime @default(now())
}

model Offertforfragan {
  id              String    @id @default(uuid())
  foretag         String
  orgnr           String?
  kontaktperson   String
  email           String
  telefon         String
  stad            String
  antal_personer  Int?
  inflyttning     DateTime?
  bostadstyp      String?
  meddelande      String?
  // Lead-uppföljning (admin) — obehandlad | kontaktad | offert_skickad | vunnen | forlorad
  // (äldre rader kan ha legacy-värdet "ny" — UI behandlar det som "obehandlad")
  status          String    @default("obehandlad")
  intern_notering String?   @db.Text
  uppdaterad      DateTime?
  created_at      DateTime  @default(now())

  // Admin-lista hämtas sorterad på created_at desc
  @@index([created_at])
}